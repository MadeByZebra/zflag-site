--- /dev/null
+++ b/tests/test_inject_outcome_244.py
@@ -0,0 +1,35 @@
+"""Protect batch-result truthfulness and the visual Inject control contract."""
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[1]
+
+def test_native_partial_success_has_distinct_outcome_and_exit_code():
+    text=(ROOT/'native-enhanced/fastflag_injector_gui_enhanced.cpp').read_text(encoding='utf-8')
+    code=text.split('int CommandLineInject(',1)[1].split('int WINAPI WinMain(',1)[0]
+    assert 'result.AddMember("ok", successes > 0, allocator)' in code
+    assert 'result.AddMember("partial", successes > 0 && failures > 0, allocator)' in code
+    assert 'return successes > 0 ? 0 : 1;' in code
+    assert 'details.PushBack(entry, allocator)' in code
+
+def test_app_does_not_claim_partial_batch_fully_failed():
+    text=(ROOT/'src/App.tsx').read_text(encoding='utf-8')
+    assert 'confirmedPartial = successfulResults > 0 && failedResults > 0' in text
+    assert 'if ((!response.ok || result.ok === false) && !confirmedPartial)' in text
+    assert 'showToast(errors ? "Partially applied" : "Configuration applied"' in text
+    assert 'Injection result counts did not match individual flag results' in text
+
+def test_matched_button_design_and_busy_control():
+    text=(ROOT/'src/App.tsx').read_text(encoding='utf-8')
+    css=(ROOT/'src/index.css').read_text(encoding='utf-8')
+    shared=(ROOT/'src/components/ui/button.tsx').read_text(encoding='utf-8')
+    assert 'zflag-commandbar' in text and 'zflag-inject-group' in text
+    assert 'zflag-control-primary' in text
+    assert 'v2.0.44: Single command surface' in css
+    assert '.zflag-commandbar .zflag-inject-button' in css
+    assert 'zflag-control inline-flex' in shared
+    assert 'if (applyingNowRef.current) return false' in text
+
+def test_no_writes_without_verifiable_per_flag_evidence():
+    backend=(ROOT/'backend/server.py').read_text(encoding='utf-8')
+    assert 'Native injector result counts do not match the submitted flags' in backend
+    assert 'Native injector returned success without per-flag evidence' in backend
+    assert 'output["outcome"] = "applied" if applied and not errors else "partial" if applied else "failed"' in backend
