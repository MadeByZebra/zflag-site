{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZFLAG",
  "version": "2.0.9",
  "identifier": "com.fflagstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZFLAG",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; media-src 'self' data: blob:; worker-src 'self' blob:; child-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "externalBin": [
      "binaries/fflag-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "startMenuFolder": "ZFLAG",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Zebra",
    "shortDescription": "ZFLAG - FFlag Studio",
    "longDescription": "ZFLAG is a desktop FFlag configuration studio built by Zebra."
  }
}
