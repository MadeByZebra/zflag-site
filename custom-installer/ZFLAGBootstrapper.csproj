<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZFLAGInstaller</AssemblyName>
    <ApplicationIcon>Assets\zflag.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload\zflag-payload.zip" LogicalName="ZFLAG.Setup.Payload" />
    <Resource Include="Assets\zflag-logo.png" />
  </ItemGroup>
</Project>
